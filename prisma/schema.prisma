generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String         @id @default(cuid())
  name            String
  level           Int
  position        String?
  heightCm        Int?
  avatarUrl       String?
  notes           String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  teamPlayers     TeamPlayer[]
  weekAttendances WeekAttendee[]
  weekAbsences    WeekAbsence[]
  weekWaitlists   WeekWaitlist[]
  mvps            WeeklyMvp[]
}

model Week {
  id        String         @id @default(cuid())
  date      DateTime
  status    String         @default("draft")
  /// Kontenjan (null = sınırsız). Dolunca yeni "Geliyorum" diyenler yedek listesine düşer.
  capacity  Int?
  createdAt DateTime       @default(now())
  attendees WeekAttendee[]
  absences  WeekAbsence[]
  waitlist  WeekWaitlist[]
  teams     Team[]
  matches   Match[]
  mvps      WeeklyMvp[]

  @@index([status])
}

model WeekAttendee {
  id       String @id @default(cuid())
  weekId   String
  playerId String
  week     Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([weekId, playerId])
  @@index([playerId])
}

/// Oyuncunun "Gelmiyorum" bildirimi. "Geliyorum" = WeekAttendee kaydı.
model WeekAbsence {
  id        String   @id @default(cuid())
  weekId    String
  playerId  String
  createdAt DateTime @default(now())
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([weekId, playerId])
  @@index([playerId])
}

/// Yedek listesi — sıra createdAt'e göre.
model WeekWaitlist {
  id        String   @id @default(cuid())
  weekId    String
  playerId  String
  createdAt DateTime @default(now())
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([weekId, playerId])
  @@index([playerId])
}

model Team {
  id          String       @id @default(cuid())
  weekId      String
  name        String
  week        Week         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  players     TeamPlayer[]
  homeMatches Match[]      @relation("MatchTeamA")
  awayMatches Match[]      @relation("MatchTeamB")
}

model TeamPlayer {
  id       String @id @default(cuid())
  teamId   String
  playerId String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([playerId])
}

model Match {
  id           String   @id @default(cuid())
  weekId       String
  teamAId      String
  teamBId      String
  sets         Json
  targetPoints Int?
  createdAt    DateTime @default(now())
  week         Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  teamA        Team     @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB        Team     @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: Cascade)

  @@index([weekId])
  @@index([teamAId])
  @@index([teamBId])
}

model WeeklyMvp {
  id       String @id @default(cuid())
  weekId   String
  playerId String
  week     Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([weekId, playerId])
  @@index([playerId])
}
